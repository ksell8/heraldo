#!/bin/sh
set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable ble-beacon.service
        systemctl restart ble-beacon.service
    fi
fi

exit 0
